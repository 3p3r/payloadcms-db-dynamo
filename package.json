{
  "name": "payloadcms-db-dynamo",
  "version": "0.1.0",
  "description": "DynamoDB database adapter for Payload CMS (single-table design)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./migration-utils": {
      "import": "./dist/exports/migration-utils.js",
      "types": "./dist/exports/migration-utils.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm-run-all build:*",
    "build:source": "esbuild 'src/**/*.ts' 'src/*.ts' --outdir=dist --outbase=src --bundle=false --platform=node --format=esm --target=node20 --sourcemap --log-level=info",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build",
    "docker:start": "docker compose up -d dynamodb-local",
    "docker:stop": "docker compose down",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run test/**/*.int.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "example:3x": "npm run dev --prefix examples/payload-3.x",
    "example:4x": "npm run dev --prefix examples/payload-4.x",
    "examples": "npm-run-all --continue-on-error examples:stop examples:dev",
    "examples:dev": "npm-run-all -p example:3x example:4x",
    "examples:stop": "fuser -k 3000/tcp 3001/tcp"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "dynamodb",
    "database",
    "adapter",
    "cms",
    "headless"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3p3r/payloadcms-db-dynamo.git"
  },
  "bugs": {
    "url": "https://github.com/3p3r/payloadcms-db-dynamo/issues"
  },
  "homepage": "https://github.com/3p3r/payloadcms-db-dynamo#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "payload": ">=3.49.0 <5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1038.0",
    "@aws-sdk/lib-dynamodb": "^3.1038.0",
    "debug": "^4.4.3",
    "dynamodb-geo-v3": "^1.0.0",
    "exponential-backoff": "^3.1.3",
    "lodash": "^4.18.1",
    "nodes2ts": "^2.0.0",
    "rc": "^1.2.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.15.0",
    "@types/rc": "^1.2.4",
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.25.0",
    "npm-run-all": "^4.1.5",
    "payload": "^3.84.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
