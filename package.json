{
  "name": "@payloadcms/db-dynamodb",
  "version": "0.1.0",
  "description": "DynamoDB database adapter for Payload CMS",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./migration-utils": {
      "import": "./dist/exports/migration-utils.js",
      "types": "./dist/exports/migration-utils.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "docker:start": "docker compose up -d dynamodb-local",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f dynamodb-local",
    "test": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "test:integration": "vitest run test/**/*.int.spec.ts",
    "typecheck:test": "tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "payload": ">=3.49.0 <5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1038.0",
    "@aws-sdk/lib-dynamodb": "^3.1038.0",
    "dynamodb-geo-v3": "^1.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.25.0",
    "payload": "^3.84.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
