{
  "name": "payloadcms-db-dynamo",
  "version": "0.1.0",
  "description": "DynamoDB database adapter for Payload CMS (single-table design)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm-run-all build:clean build:adapter",
    "build:adapter": "npm-run-all build:source build:types",
    "build:clean": "rm -rf dist",
    "build:source": "npm-run-all build:source:mkdir build:source:bundle",
    "build:source:mkdir": "mkdir -p dist",
    "build:source:bundle": "esbuild src/index.ts --bundle --packages=external --external:payload --platform=node --format=esm --target=node20 --sourcemap --outfile=dist/index.js",
    "build:types": "npm-run-all build:types:tsc build:types:bundle build:types:strip-export build:types:augment build:types:clean",
    "build:types:tsc": "tsc --emitDeclarationOnly --outDir .build-types",
    "build:types:bundle": "dts-bundle-generator --no-check -o dist/index.d.ts .build-types/index.d.ts",
    "build:types:strip-export": "sed -i '/^export {};$/d' dist/index.d.ts",
    "build:types:augment": "printf '\\ndeclare module '\\''payload'\\'' {\\n  export interface DatabaseAdapter extends DynamoAdapter {}\\n}\\n' >> dist/index.d.ts",
    "build:types:clean": "rm -rf .build-types",
    "prepublishOnly": "npm run build",
    "docker:ensure": "tsx test/__helpers/ensureDynamodbLocal.ts",
    "docker:start": "docker compose up -d dynamodb-local",
    "docker:stop": "docker compose down",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run test/**/*.int.spec.ts",
    "test:e2e": "npm-run-all build e2e:install-examples e2e:playwright",
    "e2e:install-examples": "npm-run-all e2e:install-examples:3x e2e:install-examples:4x",
    "e2e:install-examples:3x": "npm install --prefix examples/payload-3.x --no-audit --no-fund",
    "e2e:install-examples:4x": "npm install --prefix examples/payload-4.x --no-audit --no-fund",
    "e2e:playwright": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "example:3x": "npm run dev --prefix examples/payload-3.x",
    "example:4x": "npm run dev --prefix examples/payload-4.x",
    "examples": "npm-run-all --continue-on-error examples:stop examples:dev",
    "examples:dev": "npm-run-all -p example:3x example:4x",
    "examples:stop": "fuser -k 3000/tcp 3001/tcp"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "dynamodb",
    "database",
    "adapter",
    "cms",
    "headless"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3p3r/payloadcms-db-dynamo.git"
  },
  "bugs": {
    "url": "https://github.com/3p3r/payloadcms-db-dynamo/issues"
  },
  "homepage": "https://github.com/3p3r/payloadcms-db-dynamo#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "payload": ">=3.49.0 <5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1038.0",
    "@aws-sdk/lib-dynamodb": "^3.1038.0",
    "debug": "^4.4.3",
    "dynamodb-geo-v3": "^1.0.0",
    "exponential-backoff": "^3.1.3",
    "lodash": "^4.18.1",
    "nodes2ts": "^2.0.0",
    "rc": "^1.2.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/debug": "^4.1.13",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.15.0",
    "@types/rc": "^1.2.4",
    "@vitest/coverage-v8": "^3.0.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.25.0",
    "npm-run-all": "^4.1.5",
    "payload": "^3.85.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
